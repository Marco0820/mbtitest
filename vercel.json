{
  "crons": [
    {
      "path": "/api/cron/fetch-blogs",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/outreach",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://mbti16personalities.online/$1",
      "permanent": true
    }
  ]
}
